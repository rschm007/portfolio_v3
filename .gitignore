# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production / build output
/dist
/build

# vite
*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor / os
.DS_Store
.idea

# env
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Claude Code / Impeccable — machine-local state, not shared project config
.claude/settings.local.json
.claude/worktrees/
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/live/

# Impeccable's compiled CLI binary — platform-specific (currently macOS arm64),
